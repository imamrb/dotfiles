[user]
	email = imam.swe@gmail.com
	name = Imam Hossain

[commit]
	gpgsign = true

# Per-machine signing key (NOT tracked in dotfiles)
[includeIf "gitdir:~/"]
	path = .gitconfig-local

# Work identity
## recommended to set:
# [core]
#   fsmonitor = true
[includeIf "gitdir:~/Work/"]
	path = .gitconfig-work

# Dotfiles bare repo settings (fsmonitor off, untracked excludes)
[includeIf "gitdir:~/.dotfiles/"]
	path = ~/.dotfiles_repo_config

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[pull]
	ff = true

[core]
	excludesFile = ~/.gitignore
	pager = diff-so-fancy | less --tabs=2 -FXRi
	autocrlf = input
	untrackedCache = true
	commitGraph = true
	multiPackIndex = true
	fsmonitor = false
	# pager = delta --line-numbers

[color]
	diff = auto
	interactive = auto

[diff-so-fancy]
	changeHunkIndicators = true
	stripLeadingSymbols = false
	markEmptyLines = true

[color "diff"]
	frag = magenta bold
	meta = 11
	func = 146 bold
	whitespace = red reverse

[delta]
    line-numbers = true
    navigate = true

[interactive]
    diffFilter = delta --color-only

[init]
	defaultBranch = main

[open "https://ssh.github.com"]
	domain = github.com
[url "git@gitlab.com:"]
	insteadOf = https://gitlab.com/
[diff]
	algorithm = histogram
[gpg]
	pinentry-mode = loopback
[gc]
	writeCommitGraph = true
[fetch]
	writeCommitGraph = true
	unpackLimit = 1
[repack]
	writeBitmaps = true
[index]
	threads = 0
